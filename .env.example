# =============================================================================
#  doqa-ai-cases — конфигурация
#  Скопируйте файл в .env и заполните значения:  copy .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
#  DoQA (источник тест-кейсов)
# -----------------------------------------------------------------------------
# Базовый адрес DoQA. Если он уже заканчивается на /api — путь ниже склеится
# корректно (дубль /api не появится).
DOQA_BASE_URL=https://doqa.example.com

# Токен доступа. Уходит в заголовок DOQA_AUTH_HEADER со схемой DOQA_AUTH_SCHEME.
DOQA_TOKEN=

# Альтернатива токену: Basic-аутентификация.
# DOQA_USERNAME=
# DOQA_PASSWORD=

# Альтернатива: готовая cookie-сессия (например, "sessionid=abc; csrftoken=xyz").
# DOQA_COOKIE=

# ID пространства по умолчанию — чтобы не передавать --space-id каждый раз.
DOQA_SPACE_ID=

# Готовая xlsx-выгрузка вместо запроса к DoQA (для команды cases/all).
# DOQA_EXPORT_FILE=.\runs\export\doqa\cases_export.xlsx
DOQA_EXPORT_FILE=

# Путь метода экспорта (обычно менять не нужно).
DOQA_EXPORT_PATH=/api/cases/export

# Как передавать токен. Для схемы "Token" или "Bearer" — соответственно.
DOQA_AUTH_HEADER=Authorization
DOQA_AUTH_SCHEME=Bearer

# Дополнительные заголовки в JSON, если инсталляция требует, например, X-Org-Id.
# DOQA_EXTRA_HEADERS={"X-Org-Id": "123"}

# Таймаут одного запроса, секунды.
DOQA_TIMEOUT=180

# Проверять TLS-сертификат. false — только для самоподписанных стендов.
DOQA_VERIFY_SSL=true

# -----------------------------------------------------------------------------
#  OpenAI (или совместимый прокси/шлюз)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Модель. Нужна модель с поддержкой JSON/structured outputs, например gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Температура. 0.1–0.3 — стабильные, воспроизводимые формулировки.
# Пустое значение = не передавать параметр (нужно для некоторых reasoning-моделей).
OPENAI_TEMPERATURE=0.2

# Лимит токенов ответа. 0 = не передавать (отдать на усмотрение модели).
OPENAI_MAX_TOKENS=0

OPENAI_TIMEOUT=240
OPENAI_MAX_RETRIES=4

# Как просить JSON: auto | json_schema | json_object | text.
# auto — сначала structured outputs, при отказе провайдера — json_object, затем текст.
OPENAI_JSON_MODE=auto

# -----------------------------------------------------------------------------
#  Конвейер
# -----------------------------------------------------------------------------
# Папка с требованиями по умолчанию (вместо --requirements).
REQUIREMENTS_DIR=.\requirements

# Размер фрагмента требований на один запрос (символов).
REQUIREMENTS_CHUNK_CHARS=12000

# Сводить чек-лист отдельным запросом (убирает дубли между документами).
CHECKLIST_CONSOLIDATE=true

# Если JSON чек-листа длиннее — сведение пропускается (защита от переполнения контекста).
CONSOLIDATE_MAX_CHARS=60000

# Сколько символов требований максимум попадает в один запрос генерации кейсов.
REQUIREMENTS_CONTEXT_MAX_CHARS=18000

# Сколько символов отводится одному эталонному кейсу в промпте.
REFERENCE_CASE_MAX_CHARS=2200

# Сколько похожих кейсов из выгрузки подбирать под один пункт чек-листа.
SIMILAR_CASES_K=4

# Верхний предел эталонных кейсов в одном запросе.
MAX_REFERENCE_CASES=8

# Сколько пунктов чек-листа генерировать за один запрос.
CASE_BATCH_SIZE=3

# Сколько непокрытых пунктов повторно запросить (0 — отключить повторы).
MAX_RETRY_ITEMS=20

# Кэш ответов модели по хэшу промпта: экономит деньги при повторных запусках.
LLM_CACHE=true
LLM_CACHE_DIR=.cache/llm

# Сохранять рендеры всех промптов в каталог запуска.
SAVE_PROMPTS=true

# Каталог с шаблонами промптов.
PROMPTS_DIR=prompts

# Куда складывать результаты запусков без явного --out.
RUNS_DIR=runs

# Формат экспорта по умолчанию: xlsx (нужен для разбора шагов) или pdf.
EXPORT_FORMAT=xlsx

# Уровень логирования: DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO
